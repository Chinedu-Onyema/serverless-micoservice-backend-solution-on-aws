{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLambdaReadinDynamoDBStreams",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeStream",
        "dynamodb:ListStreams",
        "dynamodb:GetRecords"
      ],
      "Resource": "*"
    }
  ]
}